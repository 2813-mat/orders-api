NODE_ENV=development
PORT=3000

# Valores para rodar no host (npm run start:dev, migrations, testes).
# No docker compose, os hosts internos (mysql, redis, keycloak) são sobrescritos em `environment`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=orders
DB_PASSWORD=orders
DB_NAME=orders

REDIS_HOST=localhost
REDIS_PORT=6379

QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
WORKER_CONCURRENCY=5
PROCESSING_MIN_MS=1000
PROCESSING_MAX_MS=2000

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
# Tempo máximo de uma publicação no Redis (com o Redis fora o BullMQ espera indefinidamente)
OUTBOX_PUBLISH_TIMEOUT_MS=5000

# Keycloak — issuer (URL pública, a que aparece no token) x JWKS (URL interna da rede Docker)
KEYCLOAK_ISSUER=http://localhost:8080/realms/orders
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/orders/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=orders-api
KEYCLOAK_CLIENT_ID=orders-api
# Intervalo mínimo entre duas gravações do perfil local (tabela users) do mesmo usuário
USER_SYNC_INTERVAL_MS=300000

LOG_LEVEL=info
