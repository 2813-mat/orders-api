NODE_ENV=development
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USER=orders
DB_PASSWORD=orders
DB_NAME=orders

REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
WORKER_CONCURRENCY=5
PROCESSING_MIN_MS=1000
PROCESSING_MAX_MS=2000

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# Keycloak — issuer (URL pública, a que aparece no token) x JWKS (URL interna da rede Docker)
KEYCLOAK_ISSUER=http://localhost:8080/realms/orders
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/orders/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=orders-api
KEYCLOAK_CLIENT_ID=orders-api

LOG_LEVEL=info
